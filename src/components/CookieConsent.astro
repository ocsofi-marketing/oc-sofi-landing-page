<script>
  import 'vanilla-cookieconsent/dist/cookieconsent.css';
  import * as CookieConsent from 'vanilla-cookieconsent';

  declare global {
    interface Window {
      dataLayer: unknown[];
    }
  }

  function gtag(...args: unknown[]) {
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push(args);
  }

  function updateConsent() {
    const analytics = CookieConsent.acceptedCategory('analytics');
    const marketing = CookieConsent.acceptedCategory('marketing');
    gtag('consent', 'update', {
      analytics_storage: analytics ? 'granted' : 'denied',
      ad_storage: marketing ? 'granted' : 'denied',
      ad_user_data: marketing ? 'granted' : 'denied',
      ad_personalization: marketing ? 'granted' : 'denied',
    });
    window.dataLayer.push({ event: 'cc_consent_update' });
  }

  CookieConsent.run({
    guiOptions: {
      consentModal: {
        layout: 'box inline',
        position: 'bottom center',
        equalWeightButtons: false,
      },
      preferencesModal: {
        layout: 'box',
        equalWeightButtons: false,
      },
    },

    categories: {
      necessary: {
        enabled: true,
        readOnly: true,
      },
      analytics: {},
      marketing: {},
    },

    onConsent: updateConsent,
    onChange: updateConsent,

    language: {
      default: 'sk',
      translations: {
        sk: {
          consentModal: {
            title: 'Používame cookies',
            description:
              'Cookies používame na analýzu návštevnosti a meranie výkonu kampaní. Pomáhajú nám zlepšovať web a zobrazovať relevantný obsah. Svoj výber môžete kedykoľvek zmeniť cez „Nastavenia Cookies“ v pätičke.',
            acceptAllBtn: 'Prijať všetky',
            acceptNecessaryBtn: 'Odmietnuť',
            showPreferencesBtn: 'Spravovať nastavenia',
            footer:
              '<a href="https://www.ocsofi.sk/ochrana-osobnych-udajov/" target="_blank" rel="noopener">Zásady ochrany osobných údajov</a>',
          },
          preferencesModal: {
            title: 'Nastavenia cookies',
            acceptAllBtn: 'Prijať všetky',
            acceptNecessaryBtn: 'Odmietnuť všetky',
            savePreferencesBtn: 'Uložiť nastavenia',
            closeIconLabel: 'Zavrieť',
            sections: [
              {
                title: 'Nevyhnutné cookies',
                description:
                  'Zabezpečujú základné fungovanie webu (napr. odoslanie formulára a uloženie vášho súhlasu). Nedajú sa vypnúť.',
                linkedCategory: 'necessary',
              },
              {
                title: 'Analytické cookies',
                description:
                  'Pomáhajú nám pochopiť, ako web používate — ktoré sekcie vás zaujímajú a odkiaľ prichádzate. Dáta sú anonymizované.',
                linkedCategory: 'analytics',
              },
              {
                title: 'Marketingové cookies',
                description:
                  'Slúžia na meranie výkonu reklamných kampaní a zobrazovanie relevantných ponúk na iných platformách.',
                linkedCategory: 'marketing',
              },
              {
                title: 'Viac informácií',
                description:
                  'Podrobnosti o spracovaní údajov nájdete v dokumente <a href="https://www.ocsofi.sk/ochrana-osobnych-udajov/" target="_blank" rel="noopener">Zásady ochrany osobných údajov</a>.',
              },
            ],
          },
        },
      },
    },
  });

  document
    .querySelectorAll('.js-cookie-settings')
    .forEach((el) =>
      el.addEventListener('click', () => CookieConsent.showPreferences()),
    );
</script>

