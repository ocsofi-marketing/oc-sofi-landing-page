---
import { Image } from 'astro:assets';
import CtaButton from './CtaButton.astro';
import SofiLogo from './SofiLogo.astro';
import heroImg from '../assets/images/hero.jpg';
---

<section class="relative flex min-h-screen flex-col bg-ink">
  <Image
    src={heroImg}
    widths={[768, 1280, 1920]}
    sizes="100vw"
    alt="Vizualizácia OC SOFI, Bratislavská 74, Trnava"
    class="absolute inset-0 block h-full w-full object-cover"
    loading="eager"
    fetchpriority="high"
  />
  <div
    class="absolute inset-0 bg-[linear-gradient(180deg,rgba(20,19,17,0.6)_0%,rgba(20,19,17,0.44)_34%,rgba(20,19,17,0.82)_100%)]"
  >
  </div>

  <header
    class="relative z-10 grid grid-cols-[1fr_auto_1fr] items-center gap-4 px-[clamp(20px,4vw,56px)] py-[30px]"
  >
    <nav aria-label="Hlavná navigácia" class="hidden items-center gap-8 text-[14px] font-medium text-white/90 lg:flex">
      <a href="#retail" class="transition-colors hover:text-accent">Obchodné priestory</a>
      <a href="#kancelarie" class="transition-colors hover:text-accent">Kancelárie</a>
      <a href="#lokalita" class="transition-colors hover:text-accent">Lokalita</a>
    </nav>
    <a href="#dopyt" class="flex justify-center" aria-label="OC SOFI">
      <SofiLogo class="h-7 w-auto text-white" />
    </a>
    <a
      href="#dopyt"
      class="justify-self-end rounded-full bg-white px-5 py-3 text-[14px] font-semibold text-navy transition-colors hover:bg-cream-light"
      >Spojte sa s nami <span class="ml-2 text-accent">↗</span></a
    >
  </header>

  <div
    class="relative z-5 flex flex-1 flex-col items-center justify-center px-[clamp(20px,4vw,56px)] pt-14 pb-24 text-center"
  >
    <span class="text-[13px] tracking-[0.18em] text-white uppercase"
      >Priestor pre váš biznis na správnom mieste</span
    >
    <h1
      class="mt-6 max-w-[26ch] [text-wrap:balance] text-[clamp(38px,5.6vw,88px)] leading-none font-normal tracking-[-0.03em] text-[#FBF9F6]"
    >
      Obchodné a kancelárske priestory <span
        class="font-serif italic tracking-[-0.01em] text-accent">v Trnave</span
      >
    </h1>
    <p
      class="mt-[30px] max-w-[60ch] [text-wrap:pretty] text-[19px] leading-[1.75] text-[#DDD8D0]"
    >
      Objavte moderné priestory s výbornou dostupnosťou, vysokou viditeľnosťou
      a bezproblémovým vlastným parkovaním.
    </p>
    <CtaButton href="#dopyt" variant="light" class="mt-[38px]">Zistiť dostupné priestory</CtaButton>
    <span
      class="mt-12 inline-flex max-w-full items-center gap-2 border border-white/10 bg-navy/45 px-3 py-2 text-left backdrop-blur-sm"
    >
      <span class="flex size-5 flex-none items-center justify-center text-accent">
        <svg
          width="17"
          height="17"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"></path>
          <circle cx="12" cy="10" r="2.5"></circle>
        </svg>
      </span>
      <span class="truncate text-[14px] leading-none font-medium tracking-[0.01em] text-white/90"
        >Bratislavská 74, Trnava</span
      >
    </span>
  </div>
</section>
