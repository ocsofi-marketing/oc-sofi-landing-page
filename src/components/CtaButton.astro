---
interface Props {
  href: string;
  class?: string;
  variant?: 'accent' | 'light';
}

const { href, class: className = '', variant = 'accent' } = Astro.props;
---

<a
  href={href}
  class:list={[
    'inline-flex items-center rounded-full px-7 py-[15px] text-[15px] font-semibold tracking-[-0.01em] shadow-[0_8px_20px_rgba(44,23,23,0.16)] transition-all duration-200 hover:-translate-y-px',
    variant === 'light'
      ? 'bg-white text-navy hover:bg-cream-light'
      : 'bg-accent text-white hover:bg-accent-hover',
    className,
  ]}
>
  <slot />
</a>
