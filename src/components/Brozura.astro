---
import { getImage } from 'astro:assets';
import brozuraBg from '../assets/images/brozura-bg.jpg';

const bg = await getImage({ src: brozuraBg, format: 'webp' });

const body = [
  'aktuálne dostupných jednotkách',
  'pôdorysoch a výmerách',
  'podmienkach prenájmu',
  'možnostiach úpravy priestoru',
  'termíne odovzdania',
];
---

<section
  id="brozura"
  class="overflow-visible bg-center bg-no-repeat"
  style={`background-image:url('${bg.src}')`}
>
  <div
    class="mx-auto grid max-w-[1280px] grid-cols-[repeat(auto-fit,minmax(340px,1fr))] items-center gap-[clamp(32px,5vw,72px)] px-[clamp(20px,4vw,40px)] py-24"
  >
    <div>
      <h2
        class="mt-6 mb-0 max-w-[24ch] [text-wrap:balance] text-[clamp(32px,4vw,56px)] leading-[1.08] font-normal tracking-[-0.028em] text-white"
      >
        Máte záujem o&nbsp;<span class="font-serif italic text-accent"
          >konkrétny priestor?</span
        >
      </h2>
      <div
        class="mt-[26px] max-w-[52ch] [text-wrap:pretty] text-[18px] leading-[1.8] text-white"
      >
        <div>
          Stiahnite si prezentačnú brožúru s detailmi o projekte, lokalite,
          dostupných priestoroch, pôdorysoch a technickom štandarde.
        </div>
      </div>
    </div>
    <div class="rounded-3xl border border-[#E2DCD2] bg-white p-10">
      <span
        class="block text-[13px] tracking-[0.14em] text-[#8A857C] uppercase"
        >Brožúra zahŕňa informácie o</span
      >
      <div class="mt-6 grid gap-4">
        {
          body.map((item) => (
            <div class="flex items-start gap-[14px]">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#F4551E"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="mt-[3px] block flex-none"
              >
                <path d="M4 12.5 9 17.5 20 6.5" />
              </svg>
              <span class="text-[16px] leading-[1.55] text-[#3F3D39]">
                {item}
              </span>
            </div>
          ))
        }
      </div>
      <a
        href="#dopyt"
        class="mt-8 flex items-center justify-between gap-4 bg-ink px-7 py-[22px] text-[16px] font-semibold text-[#FBF9F6] transition-colors hover:bg-accent hover:text-white"
        >Získať informácie o priestoroch <span class="text-[18px]">→</span></a
      >
      <p class="mt-[14px] mb-0 text-[13px] leading-[1.65] text-[#8A857C]">
        Ponuku posielame na základe dopytu, aby zodpovedala vášmu typu
        prevádzky.
      </p>
    </div>
  </div>
</section>
