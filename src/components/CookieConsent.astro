    --cc-cookie-category-block-hover-border: #d8d0c4;
    --cc-cookie-category-expanded-block-hover-bg: #f5f4ed;
    --cc-cookie-category-expanded-block-bg: #f7f4ee;
    --cc-footer-bg: #f7f4ee;
