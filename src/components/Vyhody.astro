---
const vyhody = [
  {
    icon: '<path d="M4 4h7v7H4z"></path><path d="M13 4h7v16h-7z"></path><path d="M4 13h7v7H4z"></path>',
    title: 'Priestor na mieru vašej prevádzke',
    text: 'Ponúkame priestory s variabilnou dispozíciou — výmeru riešime individuálne a jednotky sa dajú spájať aj deliť ešte pred dokončením.',
  },
  {
    icon: '<path d="M20 15.5v3a2 2 0 0 1-2.2 2 17.5 17.5 0 0 1-7.6-2.7 17 17 0 0 1-5.2-5.2A17.5 17.5 0 0 1 2.3 5.2 2 2 0 0 1 4.3 3h3a2 2 0 0 1 2 1.7c.1 1 .3 1.9.6 2.8a2 2 0 0 1-.5 2.1L8.6 10.6a14 14 0 0 0 5 5l1-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.5 2.8.6a2 2 0 0 1 1.7 2Z"></path>',
    title: 'Prenájom priamo od developera',
    text: 'Prenajímame bez sprostredkovateľa a bez provízie — o podmienkach aj úpravách priestoru sa dohodnete priamo s nami.',
  },
];
---

<section id="vyhody" class="border-t border-white/10 bg-cream-light">
  <div
    class="mx-auto grid max-w-[1280px] grid-cols-[repeat(auto-fit,minmax(320px,1fr))] gap-8 px-[clamp(20px,4vw,40px)] py-16"
  >
    {
      vyhody.map((v) => (
        <div class="flex items-start gap-5">
          <span class="flex size-[46px] flex-none items-center justify-center rounded-full bg-accent/16 text-accent">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={v.icon}
            />
          </span>
          <div>
            <h2 class="m-0 text-[21px] font-medium tracking-[-0.01em] text-black">
              {v.title}
            </h2>
            <p class="mt-2 mb-0 max-w-[46ch] text-[16px] leading-[1.7] text-[#54514C]">
              {v.text}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</section>
