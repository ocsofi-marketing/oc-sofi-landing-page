---
const vyhody = [
  {
    icon: '<rect x="3" y="3" width="18" height="18" rx="1"></rect><path d="M3 10h8V3"></path><path d="M11 21v-6h10"></path><path d="M15 10h6"></path><path d="M15 10V7"></path>',
    title: 'Priestor na mieru pre vašu prevádzku',
    text: 'Ponúkame priestory s flexibilnou výmerou a dispozíciou, ktoré je možné prispôsobiť potrebám vašej prevádzky ešte pred dokončením výstavby.',
  },
  {
    icon: '<path d="m3 10 4-4 4.5 4.5-3 3L3 10Z"></path><path d="m21 10-4-4-4.5 4.5 3 3L21 10Z"></path><path d="m8.5 13.5 2.5 2.5 5-5"></path><path d="m10 18 1.2 1.2a1.5 1.5 0 0 0 2.1 0l4.2-4.2"></path>',
    title: 'Prenájom priamo od developera',
    text: 'Podmienky prenájmu aj možnosti úprav priestoru riešite priamo s developerom.',
  },
];
---

<section id="vyhody" class="border-t border-white/10 bg-cream-light">
  <div
    class="mx-auto grid max-w-[1280px] grid-cols-[repeat(auto-fit,minmax(320px,1fr))] gap-8 px-[clamp(20px,4vw,40px)] py-16"
  >
    {
      vyhody.map((v) => (
        <div class="flex items-start gap-5">
          <span class="flex size-[46px] flex-none items-center justify-center rounded-full bg-accent/16 text-accent">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={v.icon}
            />
          </span>
          <div>
            <h2 class="m-0 text-[21px] font-medium tracking-[-0.01em] text-black">
              {v.title}
            </h2>
            <p class="mt-2 mb-0 max-w-[46ch] text-[16px] leading-[1.7] text-[#54514C]">
              {v.text}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</section>
