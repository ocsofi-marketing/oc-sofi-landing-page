---
const retailSpecs = [
  ['Výmera', '99,70 – 394,64 m²'],
  ['Možnosti úpravy', 'výmera je prispôsobiteľná'],
  ['Svetlá výška', '3,8 m'],
  ['Zásobovanie', 'samostatný vstup zo zadnej strany'],
  ['Stav pri prevzatí', 'holopriestor s prípojkami a samostatným meraním'],
];

const retailGallery = [
  {
    alt: 'Vizualizácia nových obchodných priestorov OC SOFI',
    desktop: '/images/retail-gallery/retail-facade-desktop.webp',
    mobile: '/images/retail-gallery/retail-facade-mobile.webp',
    full: '/images/retail-gallery/retail-facade-full.webp',
    width: 1000,
    height: 587,
  },
  {
    alt: 'Vizualizácia areálu s obchodnými priestormi OC SOFI',
    desktop: '/images/retail-gallery/retail-overview-desktop.webp',
    mobile: '/images/retail-gallery/retail-overview-mobile.webp',
    full: '/images/retail-gallery/retail-overview-full.webp',
    width: 800,
    height: 557,
  },
  {
    alt: 'Vizualizácia celého projektu OC SOFI',
    desktop: '/images/retail-gallery/retail-masterplan-desktop.webp',
    mobile: '/images/retail-gallery/retail-masterplan-mobile.webp',
    full: '/images/retail-gallery/retail-masterplan-full.webp',
    width: 545,
    height: 700,
  },
];

const officeSpecs = [
  ['Dispozícia', 'open space alebo delené kancelárie'],
  ['Vonkajší priestor', 'loggia'],
  ['Zázemie', 'zvukovoizolačné steny a stropy'],
  ['Technológie', 'dátové a slaboprúdové rozvody, smart správa'],
];

const officeGallery = [
  {
    alt: 'Interiér kancelárskej chodby so sklenenými priečkami',
    desktop: '/images/office-gallery/office-corridor-desktop.webp',
    mobile: '/images/office-gallery/office-corridor-mobile.webp',
    full: '/images/office-gallery/office-corridor-full.webp',
    width: 566,
    height: 366,
  },
  {
    alt: 'Vizualizácia administratívnej budovy OC SOFI',
    desktop: '/images/office-gallery/office-front-desktop.webp',
    mobile: '/images/office-gallery/office-front-mobile.webp',
    full: '/images/office-gallery/office-front-full.webp',
    width: 1200,
    height: 675,
  },
  {
    alt: 'Vizualizácia administratívnej budovy v areáli OC SOFI',
    desktop: '/images/office-gallery/office-building-desktop.webp',
    mobile: '/images/office-gallery/office-building-mobile.webp',
    full: '/images/office-gallery/office-building-full.webp',
    width: 707,
    height: 900,
  },
  {
    alt: 'Vizualizácia areálu OC SOFI s administratívnou budovou',
    desktop: '/images/office-gallery/office-sofi-desktop.webp',
    mobile: '/images/office-gallery/office-sofi-mobile.webp',
    full: '/images/office-gallery/office-sofi-full.webp',
    width: 511,
    height: 700,
  },
];
---

<section id="priestory" class="bg-cream">
  <div class="mx-auto max-w-[1440px] px-[clamp(20px,4vw,56px)] pt-[clamp(96px,11vw,160px)] pb-[clamp(96px,11vw,160px)]">
    <div class="mx-auto max-w-[980px] text-center">
      <h2
        class="m-0 [text-wrap:balance] text-[clamp(42px,6.3vw,82px)] leading-[0.98] font-normal tracking-[-0.04em] text-heading"
      >
        Vyberte si <span class="font-serif italic text-accent">priestor</span><br />
        pre svoje podnikanie
      </h2>
      <p
        class="mx-auto mt-[30px] mb-0 max-w-[58ch] [text-wrap:pretty] text-[18px] leading-[1.8] text-[#5A6470]"
      >
        Ponúkame obchodné priestory na prízemí a kancelárske priestory na druhom
        podlaží. Vyberte si typ priestoru a pozrite si detaily.
      </p>
    </div>

    <div id="retail" class="mt-[clamp(64px,9vw,120px)]">
    <div
      class="grid grid-cols-[repeat(auto-fit,minmax(360px,1fr))] items-center gap-[clamp(32px,4vw,56px)] lg:grid-cols-[minmax(0,0.78fr)_minmax(0,1.22fr)]"
    >
      <div class="max-w-[52ch]">
        <h2
          class="m-0 max-w-[20ch] font-serif text-[clamp(30px,3.4vw,48px)] leading-[1.06] font-normal tracking-[-0.01em]"
        >
          <span class="italic">Obchodné priestory</span>
        </h2>
        <p
          class="mt-6 mb-0 max-w-[56ch] [text-wrap:pretty] text-[17px] leading-[1.85] text-[#5A6470]"
        >
          Jednotky na prízemí ponúkajú presklenú fasádu po celej šírke
          prevádzky, vlastný vstup priamo z parkoviska a otvorený pôdorys s
          možnosťou flexibilného prispôsobenia podľa potrieb nájomcu. Komfortné
          fungovanie prevádzky zabezpečuje samostatné zásobovanie zo zadnej
          strany objektu, vlastné prípojky a pripravená technická
          infraštruktúra pre každú jednotku. Možnosť označenia prevádzky nad
          vstupom a na spoločnom pylóne zároveň zabezpečuje dobrú viditeľnosť
          vašej značky.
        </p>
        <div class="mt-[30px] grid border-t border-[#D8D0C4]">
          {
            retailSpecs.map(([label, value]) => (
              <div class="grid grid-cols-[minmax(112px,0.6fr)_minmax(0,1.4fr)] items-center gap-4 border-b border-[#E2DCD2] py-[15px]">
                <span class="text-[15px] text-[#6B6863]">{label}</span>
                <span class="text-right text-[clamp(13px,1vw,15px)] text-ink sm:whitespace-nowrap">{value}</span>
              </div>
            ))
          }
        </div>
      </div>
      <button
        type="button"
        class="group relative overflow-hidden bg-[#E7E1D8] text-left"
        data-retail-gallery-open="0"
        aria-label={`Otvoriť fotografiu: ${retailGallery[0].alt}`}
      >
        <picture class="block w-full">
          <source media="(max-width: 640px)" srcset={retailGallery[0].mobile} />
          <img
            src={retailGallery[0].desktop}
            alt={retailGallery[0].alt}
            width={retailGallery[0].width}
            height={retailGallery[0].height}
            class="block h-auto w-full object-contain transition-transform duration-500 group-hover:scale-[1.03]"
            loading="lazy"
          />
        </picture>
        <span class="absolute right-3 bottom-3 flex size-9 items-center justify-center rounded-full bg-black/60 text-[18px] text-white opacity-0 backdrop-blur-sm transition-opacity group-hover:opacity-100" aria-hidden="true">↗</span>
      </button>
    </div>
    <div class="mt-[clamp(32px,4vw,56px)] grid grid-cols-[minmax(0,3fr)_minmax(0,2fr)] items-start gap-[clamp(20px,2.5vw,32px)]">
      {
        retailGallery.slice(1).map((image, index) => (
          <button
            type="button"
            class="group relative overflow-hidden bg-[#E7E1D8] text-left"
            data-retail-gallery-open={index + 1}
            aria-label={`Otvoriť fotografiu: ${image.alt}`}
          >
            <picture class="block w-full">
              <source media="(max-width: 640px)" srcset={image.mobile} />
              <img
                src={image.desktop}
                alt={image.alt}
                width={image.width}
                height={image.height}
                class="block h-auto w-full object-contain transition-transform duration-500 group-hover:scale-[1.03]"
                loading="lazy"
              />
            </picture>
            <span class="absolute right-3 bottom-3 flex size-9 items-center justify-center rounded-full bg-black/60 text-[18px] text-white opacity-0 backdrop-blur-sm transition-opacity group-hover:opacity-100" aria-hidden="true">↗</span>
          </button>
        ))
      }
    </div>
    </div>
  </div>
</section>

<dialog
  data-retail-gallery
  class="fixed inset-0 m-auto h-dvh w-dvw max-h-none max-w-none border-0 bg-black/92 p-5 text-white backdrop:bg-black/70"
  aria-label="Galéria obchodných priestorov"
>
  <div class="relative mx-auto flex h-full max-w-[1600px] items-center justify-center">
    <button
      type="button"
      data-retail-gallery-close
      class="absolute top-0 right-0 z-10 flex size-11 items-center justify-center rounded-full bg-white/12 text-[26px] transition-colors hover:bg-white/22"
      aria-label="Zavrieť galériu">×</button
    >
    <button
      type="button"
      data-retail-gallery-prev
      class="absolute left-0 z-10 flex size-12 items-center justify-center rounded-full bg-white/12 text-[28px] transition-colors hover:bg-white/22"
      aria-label="Predchádzajúca fotografia">←</button
    >
    <figure class="m-0 flex max-h-full flex-col items-center gap-4 px-14">
      <img
        data-retail-gallery-image
        src=""
        alt=""
        class="max-h-[calc(100dvh-120px)] max-w-full object-contain"
      />
      <figcaption data-retail-gallery-caption class="text-center text-[15px] text-white/75">
      </figcaption>
    </figure>
    <button
      type="button"
      data-retail-gallery-next
      class="absolute right-0 z-10 flex size-12 items-center justify-center rounded-full bg-white/12 text-[28px] transition-colors hover:bg-white/22"
      aria-label="Nasledujúca fotografia">→</button
    >
  </div>
</dialog>

<script define:vars={{ retailGallery }}>
  const dialog = document.querySelector('[data-retail-gallery]');
  const lightboxImage = dialog?.querySelector('[data-retail-gallery-image]');
  const caption = dialog?.querySelector('[data-retail-gallery-caption]');
  let activeImage = 0;

  const showImage = (index) => {
    activeImage = (index + retailGallery.length) % retailGallery.length;
    const image = retailGallery[activeImage];
    if (lightboxImage) {
      lightboxImage.src = image.full;
      lightboxImage.alt = image.alt;
    }
    if (caption) caption.textContent = image.alt;
  };

  document.querySelectorAll('[data-retail-gallery-open]').forEach((button) => {
    button.addEventListener('click', () => {
      showImage(Number(button.dataset.retailGalleryOpen));
      dialog?.showModal();
    });
  });

  dialog?.querySelector('[data-retail-gallery-close]')?.addEventListener('click', () => dialog.close());
  dialog?.querySelector('[data-retail-gallery-prev]')?.addEventListener('click', () => showImage(activeImage - 1));
  dialog?.querySelector('[data-retail-gallery-next]')?.addEventListener('click', () => showImage(activeImage + 1));

  document.addEventListener('keydown', (event) => {
    if (!dialog?.open) return;
    if (event.key === 'ArrowLeft') showImage(activeImage - 1);
    if (event.key === 'ArrowRight') showImage(activeImage + 1);
  });
</script>

<section id="kancelarie" class="bg-cream">
  <div class="mx-auto max-w-[1440px] px-[clamp(20px,4vw,56px)] pt-0 pb-[clamp(96px,11vw,160px)]">
    <div
      class="grid grid-cols-[repeat(auto-fit,minmax(360px,1fr))] items-center gap-[clamp(32px,4vw,56px)] lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]"
    >
      <button
        type="button"
        class="group relative overflow-hidden bg-[#E7E1D8] text-left"
        data-office-gallery-open="0"
        aria-label={`Otvoriť fotografiu: ${officeGallery[0].alt}`}
      >
        <picture class="block w-full">
          <source media="(max-width: 640px)" srcset={officeGallery[0].mobile} />
          <img
            src={officeGallery[0].desktop}
            alt={officeGallery[0].alt}
            width={officeGallery[0].width}
            height={officeGallery[0].height}
            class="block h-auto w-full object-contain transition-transform duration-500 group-hover:scale-[1.03]"
            loading="lazy"
          />
        </picture>
        <span class="absolute right-3 bottom-3 flex size-9 items-center justify-center rounded-full bg-black/60 text-[18px] text-white opacity-0 backdrop-blur-sm transition-opacity group-hover:opacity-100" aria-hidden="true">↗</span>
      </button>
      <div>
        <h2
          class="m-0 max-w-[20ch] font-serif text-[clamp(30px,3.4vw,48px)] leading-[1.06] font-normal tracking-[-0.01em]"
        >
          <span class="italic">Kancelárske priestory</span>
        </h2>
        <p
          class="mt-6 mb-0 max-w-[56ch] [text-wrap:pretty] text-[17px] leading-[1.85] text-[#5A6470]"
        >
          Kancelárske priestory na druhom podlaží ponúkajú flexibilnú dispozíciu
          s možnosťou vytvorenia samostatných kancelárií alebo otvoreného
          open-space riešenia. Priestory majú dostatok denného svetla, prístup
          na loggiu a pripravenú kompletnú technickú infraštruktúru vrátane
          dátových a slaboprúdových rozvodov. Súčasťou zázemia sú kuchynky,
          toalety a udržiavané spoločné priestory. Parkovanie je k dispozícii v
          parkovacom dome priamo v areáli.
        </p>
        <div class="mt-[30px] grid border-t border-[#D8D0C4]">
          {
            officeSpecs.map(([label, value]) => (
              <div class="flex justify-between gap-5 border-b border-[#E2DCD2] py-[15px]">
                <span class="text-[15px] text-[#6B6863]">{label}</span>
                <span class="text-[15px] text-ink">{value}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
    <div class="mt-[clamp(32px,4vw,56px)] grid grid-cols-1 items-start gap-[clamp(20px,2.5vw,32px)] sm:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
      {
        officeGallery.slice(1, 3).map((image, index) => (
          <button
            type="button"
            class="group relative overflow-hidden bg-[#E7E1D8] text-left"
            data-office-gallery-open={index + 1}
            aria-label={`Otvoriť fotografiu: ${image.alt}`}
          >
            <picture class="block w-full">
              <source media="(max-width: 640px)" srcset={image.mobile} />
              <img
                src={image.desktop}
                alt={image.alt}
                width={image.width}
                height={image.height}
                class="block h-auto w-full object-contain transition-transform duration-500 group-hover:scale-[1.03]"
                loading="lazy"
              />
            </picture>
            <span class="absolute right-3 bottom-3 flex size-9 items-center justify-center rounded-full bg-black/60 text-[18px] text-white opacity-0 backdrop-blur-sm transition-opacity group-hover:opacity-100" aria-hidden="true">↗</span>
          </button>
        ))
      }
    </div>
  </div>
</section>

<dialog
  data-office-gallery
  class="fixed inset-0 m-auto h-dvh w-dvw max-h-none max-w-none border-0 bg-black/92 p-5 text-white backdrop:bg-black/70"
  aria-label="Galéria kancelárskych priestorov"
>
  <div class="relative mx-auto flex h-full max-w-[1600px] items-center justify-center">
    <button type="button" data-office-gallery-close class="absolute top-0 right-0 z-10 flex size-11 items-center justify-center rounded-full bg-white/12 text-[26px] transition-colors hover:bg-white/22" aria-label="Zavrieť galériu">×</button>
    <button type="button" data-office-gallery-prev class="absolute left-0 z-10 flex size-12 items-center justify-center rounded-full bg-white/12 text-[28px] transition-colors hover:bg-white/22" aria-label="Predchádzajúca fotografia">←</button>
    <figure class="m-0 flex max-h-full flex-col items-center gap-4 px-14">
      <img data-office-gallery-image src="" alt="" class="max-h-[calc(100dvh-120px)] max-w-full object-contain" />
      <figcaption data-office-gallery-caption class="text-center text-[15px] text-white/75"></figcaption>
    </figure>
    <button type="button" data-office-gallery-next class="absolute right-0 z-10 flex size-12 items-center justify-center rounded-full bg-white/12 text-[28px] transition-colors hover:bg-white/22" aria-label="Nasledujúca fotografia">→</button>
  </div>
</dialog>

<script define:vars={{ officeGallery }}>
  const officeDialog = document.querySelector('[data-office-gallery]');
  const officeLightboxImage = officeDialog?.querySelector('[data-office-gallery-image]');
  const officeCaption = officeDialog?.querySelector('[data-office-gallery-caption]');
  let activeOfficeImage = 0;

  const showOfficeImage = (index) => {
    activeOfficeImage = (index + officeGallery.length) % officeGallery.length;
    const image = officeGallery[activeOfficeImage];
    if (officeLightboxImage) {
      officeLightboxImage.src = image.full;
      officeLightboxImage.alt = image.alt;
    }
    if (officeCaption) officeCaption.textContent = image.alt;
  };

  document.querySelectorAll('[data-office-gallery-open]').forEach((button) => {
    button.addEventListener('click', () => {
      showOfficeImage(Number(button.dataset.officeGalleryOpen));
      officeDialog?.showModal();
    });
  });

  officeDialog?.querySelector('[data-office-gallery-close]')?.addEventListener('click', () => officeDialog.close());
  officeDialog?.querySelector('[data-office-gallery-prev]')?.addEventListener('click', () => showOfficeImage(activeOfficeImage - 1));
  officeDialog?.querySelector('[data-office-gallery-next]')?.addEventListener('click', () => showOfficeImage(activeOfficeImage + 1));

  document.addEventListener('keydown', (event) => {
    if (!officeDialog?.open) return;
    if (event.key === 'ArrowLeft') showOfficeImage(activeOfficeImage - 1);
    if (event.key === 'ArrowRight') showOfficeImage(activeOfficeImage + 1);
  });
</script>
