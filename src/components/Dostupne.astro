---

<section id="dostupne" class="bg-white">
  <div class="mx-auto max-w-[1280px] px-[clamp(20px,4vw,40px)] py-24">
    <div>
      <h2
        class="m-0 max-w-[24ch] [text-wrap:balance] text-[clamp(32px,4.2vw,58px)] leading-[1.06] font-normal tracking-[-0.03em] text-heading"
      >
        Otvorenie druhej etapy je plánované na <span
          class="font-serif italic text-accent">leto 2028</span
        >
      </h2>
    </div>

    <div class="mt-10">
      <div data-stage-map class="relative mx-auto w-full max-w-[1280px] md:translate-x-[4%]">
        <img
          src="/images/plan-retail.png"
          alt="Situácia OC SOFI 1 a druhej etapy OC SOFI 2"
          class="block h-auto w-full"
          loading="lazy"
        />
        <span class="plan-label left-[5.1%] top-[52.2%]">JAC Motors</span>
        <span class="plan-label left-[17.2%] top-[52.2%]">Bistro u Mäsiara</span>

        <svg class="absolute inset-0 h-full w-full" viewBox="0 0 1920 1306" preserveAspectRatio="none" aria-label="Interaktívny plán druhej etapy OC SOFI">
          <a
            href="#kancelarie"
            data-plan-zone
            data-plan-type="office"
            data-title="Kancelárske priestory"
            data-text="Flexibilné priestory v Objekte B na druhom podlaží."
            aria-label="Kancelárske priestory v Objekte B"
          >
            <path
              class="plan-zone"
              d="M938 247 L811 155 L730 262 L661 263 L658 394 L853 464 Z"
            />
          </a>
          <g class="pointer-events-none" aria-label="Loggia pri kancelárskych priestoroch">
            <path class="plan-loggia" d="M938 247 L853 464 L867 471 L952 251 Z" />
            <text class="plan-loggia-label" x="929" y="365" transform="rotate(111 929 365)">LOGGIA</text>
          </g>
          <a
            href="#retail"
            data-plan-zone
            data-plan-type="retail"
            data-title="Obchodné priestory"
            data-text="Nové obchodné jednotky v Objekte A v OC SOFI 2."
            aria-label="Obchodné priestory v Objekte A"
          >
            <path class="plan-zone" d="M1445 438 L1192 848 L1064 773 L1263 268 L1404 321 C1452 340 1472 401 1445 438 Z" />
          </a>
        </svg>
        <div
          data-plan-card
          class="pointer-events-none absolute z-10 w-[min(290px,calc(100%-32px))] -translate-y-1/2 translate-x-3 rounded-xl bg-white px-5 py-4 opacity-0 shadow-[0_12px_34px_rgba(7,35,52,0.18)] transition-[opacity,transform] duration-200 md:px-6 md:py-5"
          aria-hidden="true"
        >
          <span class="inline-flex rounded-md bg-accent px-2.5 py-1 text-xs font-medium text-white">OC SOFI 2</span>
          <p data-plan-card-title class="mt-3 text-[24px] leading-none font-medium tracking-[-0.03em] text-navy"></p>
          <p data-plan-card-text class="mt-2 text-sm leading-relaxed text-[#51636F]"></p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const planCard = document.querySelector<HTMLElement>('[data-plan-card]');
  const planCardTitle = document.querySelector<HTMLElement>('[data-plan-card-title]');
  const planCardText = document.querySelector<HTMLElement>('[data-plan-card-text]');
  let pinnedZone: SVGAElement | null = null;

  document.querySelectorAll<SVGAElement>('[data-plan-zone]').forEach((zone, index) => {
    const showCard = () => {
      if (planCardTitle) planCardTitle.textContent = zone.dataset.title || '';
      if (planCardText) planCardText.textContent = zone.dataset.text || '';
      planCard?.classList.toggle('for-office', index === 0);
      planCard?.classList.toggle('for-retail', index === 1);
      planCard?.classList.add('is-visible');
      planCard?.setAttribute('aria-hidden', 'false');
    };

    const hideCard = () => {
      if (pinnedZone) return;
      planCard?.classList.remove('is-visible');
      planCard?.setAttribute('aria-hidden', 'true');
    };

    zone.addEventListener('mouseenter', showCard);
    zone.addEventListener('mouseleave', hideCard);
    zone.addEventListener('focus', showCard);
    zone.addEventListener('blur', hideCard);
    zone.addEventListener('click', (event) => {
      event.preventDefault();
      pinnedZone = zone;
      showCard();
    });
  });

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element) || event.target.closest('[data-plan-zone], [data-plan-card]')) return;
    pinnedZone = null;
    planCard?.classList.remove('is-visible');
    planCard?.setAttribute('aria-hidden', 'true');
  });
</script>

<style>
  .plan-label {
    position: absolute;
    z-index: 1;
    display: flex;
    min-height: 34px;
    width: 4.3%;
    align-items: center;
    justify-content: center;
    padding: 2px 4px;
    background: rgba(238, 236, 230, 0.94);
    color: #51636f;
    font-size: clamp(5px, 0.55vw, 9px);
    font-weight: 500;
    line-height: 1.12;
    text-align: center;
  }

  .plan-zone {
    cursor: pointer;
    fill: transparent;
    stroke: transparent;
    stroke-width: 4;
  }

  .plan-loggia {
    fill: rgba(255, 79, 32, 0.16);
    stroke: #ff4f20;
    stroke-width: 2.5;
    vector-effect: non-scaling-stroke;
  }

  .plan-loggia-label {
    fill: #d84421;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-anchor: middle;
  }

  [data-plan-card].is-visible {
    opacity: 1;
    transform: translate(0, -50%);
  }

  [data-plan-card].for-office {
    left: 2%;
    top: 27%;
  }

  [data-plan-card].for-retail {
    right: 0;
    left: auto;
    top: 40%;
  }

  @media (max-width: 700px) {
    .plan-label {
      min-height: 24px;
      padding: 1px;
      font-size: 6px;
    }

    [data-plan-card].for-office,
    [data-plan-card].for-retail {
      left: 50%;
      right: auto;
      top: auto;
      bottom: 3%;
      transform: translate(-50%, 12px);
    }

    [data-plan-card].is-visible {
      transform: translate(-50%, 0);
    }
  }
</style>
