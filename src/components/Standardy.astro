---
const standardy = [
  {
    icon: '<path d="M1.5 12S5 5.5 12 5.5 22.5 12 22.5 12 19 18.5 12 18.5 1.5 12 1.5 12Z"></path><circle cx="12" cy="12" r="3"></circle>',
    title: 'Viditeľnosť',
    text: 'Výborná poloha priamo na Bratislavskej ulici s veľkoformátovými presklenými výkladmi. Pre maximálnu prezentáciu vašej značky ponúkame umiestnenie loga na pylóne aj nad vstupom.',
  },
  {
    icon: '<path d="M3 19 21 5"></path><path d="M3 12h7"></path><path d="M14 19h7"></path>',
    title: 'Dostupnosť',
    text: 'Rýchle napojenie na D1 a R1. Zastávka MHD je vzdialená iba minútu chôdze a v centre mesta ste autom už do 6 minút.',
  },
  {
    icon: '<rect x="3" y="3" width="18" height="18" rx="4"></rect><path d="M9.5 17V7.5h3.2a3 3 0 0 1 0 6H9.5"></path>',
    title: 'Parkovanie',
    text: 'Bezproblémové parkovanie priamo v areáli. Ponúkame 225 vnútorných a vonkajších miest vrátane nabíjacích staníc pre elektromobily.',
  },
  {
    icon: '<path d="M4 4h7v7H4z"></path><path d="M13 4h7v16h-7z"></path><path d="M4 13h7v7H4z"></path>',
    title: 'Flexibilita',
    text: 'Priestor, ktorý sa vám prispôsobí. Jednotky sa dajú flexibilne spájať a deliť — dispozičné riešenie navrhneme presne podľa vašich predstáv ešte pred dokončením budovy.',
  },
  {
    icon: '<path d="M13 2 4.5 13.5H11L10 22l8.5-11.5H12L13 2Z"></path>',
    title: 'Technická pripravenosť',
    text: 'Moderné technológie v štandarde: autonómne vetranie a chladenie, samostatné meranie energií, vysokorýchlostná optika a 24/7 bezpečnostný monitoring celého objektu.',
  },
  {
    icon: '<path d="M3 21V9l6-4v16"></path><path d="M9 21V11l6-4v14"></path><path d="M15 21V13l6-3v11"></path>',
    title: 'Nová mestská zóna',
    text: 'Živá mestská štvrť spájajúca prácu, bývanie, obchody a služby. Profitujte z výbornej synergie moderného uzla a neustále rastúcej komunity v okolí.',
  },
];
---

<section id="standardy" class="bg-navy">
  <div class="mx-auto max-w-[1280px] px-10 py-24">
    <div class="flex flex-wrap items-end justify-between gap-14">
      <h2
        class="m-0 max-w-[18ch] text-[clamp(32px,4.2vw,58px)] leading-[1.06] font-normal tracking-[-0.03em] text-[#FBF9F6]"
      >
        Štandardy <span class="font-serif italic text-accent">priestorov</span>
      </h2>
    </div>

    <div
      class="mt-14 grid auto-rows-fr grid-cols-[repeat(auto-fit,minmax(min(100%,340px),1fr))] place-items-stretch justify-center gap-6 text-center"
    >
      {
        standardy.map((s) => (
          <div class="rounded-[18px] border border-white/10 bg-navy-card p-9">
            <span class="mx-auto flex size-[52px] items-center justify-center rounded-full bg-accent/16 text-accent">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={s.icon}
              />
            </span>
            <h3 class="mt-[26px] mb-0 text-[21px] font-medium tracking-[-0.01em] text-[#FBF9F6]">
              {s.title}
            </h3>
            <p class="mt-[10px] mb-0 text-[15px] leading-[1.75] text-[#8FA0B3]">
              {s.text}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
