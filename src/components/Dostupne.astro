---
const tabActive =
  'cursor-pointer rounded-full border border-accent bg-accent px-6 py-[14px] text-[15px] font-medium text-white';
const tabInactive =
  'cursor-pointer rounded-full border border-[#D8D0C4] bg-transparent px-6 py-[14px] text-[15px] font-medium text-ink';

---

<section id="dostupne" class="bg-white">
  <div class="mx-auto max-w-[1540px] px-[clamp(20px,3vw,40px)] py-24">
    <div class="flex flex-wrap items-end justify-between gap-12">
      <div>
        <h2
          class="m-0 max-w-[24ch] [text-wrap:balance] text-[clamp(32px,4.2vw,58px)] leading-[1.06] font-normal tracking-[-0.03em] text-heading"
        >
          Otvorenie druhej etapy je plánované na <span
            class="font-serif italic text-accent">leto 2028</span
          >
        </h2>
      </div>
      <div class="flex flex-wrap gap-[10px]">
        <button
          type="button"
          data-plan-tab="retail"
          data-active-class={tabActive}
          data-inactive-class={tabInactive}
          class={tabActive}>Obchodné priestory</button
        >
        <button
          type="button"
          data-plan-tab="office"
          data-active-class={tabActive}
          data-inactive-class={tabInactive}
          class={tabInactive}>Kancelárske priestory</button
        >
      </div>
    </div>

    <div class="mt-8">
      <div data-plan="retail" class="relative block w-full">
        <img
          src="/images/plan-retail.png"
          alt="Situácia obchodných priestorov, 1. podlažie"
          class="block h-auto w-full"
          loading="lazy"
        />
      </div>
      <img
        data-plan="office"
        src="/images/plan-office-updated.png"
        alt="Situácia kancelárskych priestorov, 2. podlažie Budovy B"
        class="mx-auto hidden h-auto w-full max-w-[980px]"
        loading="lazy"
      />
    </div>
  </div>
</section>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-plan-tab]');
  const plans = document.querySelectorAll<HTMLElement>('[data-plan]');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const selected = tab.dataset.planTab;
      tabs.forEach((t) => {
        t.className =
          t.dataset.planTab === selected
            ? t.dataset.activeClass!
            : t.dataset.inactiveClass!;
      });
      plans.forEach((img) => {
        img.classList.toggle('hidden', img.dataset.plan !== selected);
        img.classList.toggle('block', img.dataset.plan === selected);
      });
    });
  });

</script>
