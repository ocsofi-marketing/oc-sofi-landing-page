---
import SofiLogo from './SofiLogo.astro';

const navigacia = [
  ['/#retail', 'Obchodné priestory'],
  ['/#kancelarie', 'Kancelárie'],
  ['/#standardy', 'Prečo OC SOFI'],
  ['/#lokalita', 'Lokalita'],
  ['/#dopyt', 'Kontakt'],
];

const pravne = [
  [
    'https://www.ocsofi.sk/ochrana-osobnych-udajov/',
    'Zásady ochrany osobných údajov',
  ],
  ['/cookies', 'Cookies'],
];
---

<footer class="relative min-h-[560px] overflow-hidden bg-navy">
  <div
    class="pointer-events-none absolute inset-0 flex items-center justify-center overflow-hidden"
    aria-hidden="true"
  >
    <span
      class="text-[min(54vw,680px)] leading-[0.8] font-semibold tracking-[0.02em] whitespace-nowrap text-white opacity-[0.018]"
      >SOFI</span
    >
  </div>
  <div
    class="relative mx-auto grid max-w-[1700px] grid-cols-2 gap-x-8 gap-y-14 px-[clamp(24px,7vw,150px)] pt-[88px] pb-16 lg:grid-cols-[minmax(310px,1.3fr)_minmax(160px,0.65fr)_minmax(205px,0.9fr)_minmax(205px,0.85fr)] lg:gap-x-[clamp(44px,5vw,100px)]"
  >
    <div class="col-span-2 lg:col-span-1">
      <SofiLogo class="h-8 w-auto text-white" />
      <h2
        class="mt-14 mb-0 max-w-[440px] text-[clamp(34px,3.3vw,52px)] leading-[1.12] font-normal tracking-[-0.025em] text-white"
      >
        Nový štandard <span class="block font-serif italic"
          ><span class="text-accent">mestského</span> života<span
            class="text-accent">.</span
          ></span
        >
      </h2>
    </div>

    <div class="lg:pt-1">
      <div class="text-[14px] text-[#7E8FA3]">Navigácia</div>
      <div class="mt-10 grid gap-5">
        {
          navigacia.map(([href, label]) => (
            <a
              href={href}
              class="text-[16px] text-white transition-colors hover:text-accent"
            >
              {label}
            </a>
          ))
        }
      </div>
    </div>

    <div class="lg:pt-1">
      <div class="text-[14px] text-[#7E8FA3]">Právne informácie</div>
      <div class="mt-10 grid gap-5">
        {
          pravne.map(([href, label]) => (
            <a
              href={href}
              class="text-[16px] text-white transition-colors hover:text-accent"
            >
              {label}
            </a>
          ))
        }
        <button
          type="button"
          class="js-cookie-settings cursor-pointer border-none bg-transparent p-0 text-left text-[16px] text-white transition-colors hover:text-accent"
          >Nastavenia Cookies</button
        >
      </div>
    </div>

    <div class="col-span-2 text-left lg:col-span-1 lg:pt-1 lg:text-left">
      <div class="text-[14px] text-[#7E8FA3]">Kontaktné údaje</div>
      <div class="mt-10 grid gap-5">
        <a
          href="mailto:marketing@ocsofi.sk"
          class="text-[17px] text-white transition-colors hover:text-accent"
          >marketing@ocsofi.sk</a
        >
        <span class="text-[16px] leading-[1.6] text-[#8FA0B3]"
          >Bratislavská 74,<br />917 02 Trnava</span
        >
        <span class="text-[16px] leading-[1.6] text-[#8FA0B3]"
          >Verejný prenájom: Q3 2026<br />Odovzdanie: Q3 2028</span
        >
      </div>
    </div>
  </div>
  <div class="relative border-t border-white/8">
    <div
      class="mx-auto flex max-w-[1700px] flex-wrap justify-between gap-6 px-[clamp(24px,7vw,150px)] py-6"
    >
      <span class="text-[14px] text-[#7E8FA3]"
        >Vizualizácie sú ilustračné, uvedené výmery orientačné.</span
      >
      <span class="text-[14px] text-[#7E8FA3]"
        >OC SOFI All Rights Reserved. © 2026</span
      >
    </div>
  </div>
</footer>
