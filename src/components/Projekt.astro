---
const cisla: { value: string; unit?: string; label: string }[] = [
  { value: '5 000', unit: 'm²', label: 'obchodných priestorov' },
  { value: '800', unit: 'm²', label: 'kancelárskych priestorov' },
  { value: '225', label: 'vonkajších a vnútorných parkovacích miest' },
  { value: '41', label: 'bytov rôznych dispozícií' },
];
---

<section id="projekt" class="mt-28 bg-white">
  <div class="mx-auto max-w-[1060px] px-[clamp(20px,4vw,40px)] pt-20">
    <h2
      class="mx-auto mt-6 mb-0 text-center text-[clamp(24px,3.4vw,52px)] leading-[1.1] font-normal tracking-[-0.03em] whitespace-nowrap text-heading"
    >
      OC SOFI v&nbsp;<span class="font-serif italic text-accent">číslach</span>
    </h2>
  </div>

  <div
    class="mt-[clamp(32px,4vw,52px)] flex flex-wrap items-center justify-center border-t border-b border-[#DAD2C5] py-[clamp(24px,2.6vw,32px)]"
  >
    {
      cisla.map((c, i) => (
        <div
          class:list={[
            'flex flex-1 basis-[200px] flex-col items-center px-[clamp(16px,2vw,28px)] py-2 text-center',
            i < cisla.length - 1 && 'shadow-[1px_0_0_#E9E3D9]',
          ]}
        >
          {c.unit ? (
            <div class="flex items-baseline gap-3 font-serif leading-[0.9] italic text-accent">
              <span class="text-[clamp(38px,3.4vw,52px)] tracking-[-0.01em]">
                {c.value}
              </span>
              <span class="text-[clamp(16px,1.4vw,20px)]">{c.unit}</span>
            </div>
          ) : (
            <div class="font-serif text-[clamp(38px,3.4vw,52px)] leading-[0.9] tracking-[-0.01em] italic text-accent">
              {c.value}
            </div>
          )}
          <div class="mt-3 max-w-[18ch] text-[15px] leading-[1.5] text-[#6B6863]">
            {c.label}
          </div>
        </div>
      ))
    }
  </div>
</section>
