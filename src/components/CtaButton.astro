---
interface Props {
  href: string;
  class?: string;
  arrow?: string;
}

const { href, class: className = '', arrow = '↗' } = Astro.props;
---

<a
  href={href}
  class:list={[
    'group inline-flex items-center rounded-full bg-accent py-[6px] pr-[6px] pl-7 text-[15px] font-semibold tracking-[-0.01em] text-white shadow-[0_8px_20px_rgba(44,23,23,0.16)] transition-all duration-200 hover:-translate-y-px hover:bg-accent-hover',
    className,
  ]}
>
  <slot />
  <span
    class="ml-3 inline-flex size-11 items-center justify-center rounded-full bg-accent-dark text-[18px] text-accent transition-transform duration-200 group-hover:-translate-y-px group-hover:translate-x-px"
    >{arrow}</span
  >
</a>
