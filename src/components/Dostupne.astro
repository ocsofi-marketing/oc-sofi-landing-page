<section id="dostupne" class="bg-white">
  <div class="mx-auto max-w-[1280px] px-[clamp(20px,4vw,40px)] py-24">
    <div>
      <h2
        class="m-0 max-w-[24ch] [text-wrap:balance] text-[clamp(32px,4.2vw,58px)] leading-[1.06] font-normal tracking-[-0.03em] text-heading"
      >
        Otvorenie druhej etapy je plánované na <span
          class="font-serif italic text-accent">leto 2028</span
        >
      </h2>
    </div>

    <div data-floorplan-switcher class="mt-12">
      <div
        class="inline-flex w-full flex-col gap-2 rounded-[18px] bg-cream-light p-2 sm:w-auto sm:flex-row"
        role="tablist"
        aria-label="Typ pôdorysu"
      >
        <button
          id="floorplan-tab-retail"
          type="button"
          role="tab"
          aria-selected="true"
          aria-controls="floorplan-retail"
          data-floorplan-tab="retail"
          class="rounded-xl bg-navy px-5 py-3 text-[15px] font-medium text-white transition-colors"
        >
          Obchodné priestory
        </button>
        <button
          id="floorplan-tab-office"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="floorplan-office"
          data-floorplan-tab="office"
          class="rounded-xl px-5 py-3 text-[15px] font-medium text-[#5A6470] transition-colors hover:text-navy"
        >
          Kancelárske priestory
        </button>
      </div>

      <div class="mt-8">
        <div
          id="floorplan-retail"
          role="tabpanel"
          aria-labelledby="floorplan-tab-retail"
          data-floorplan-panel="retail"
          class="animate-rise"
        >
          <p class="mb-5 text-[15px] text-[#6B6863]">Pôdorys obchodných priestorov</p>
          <div class="flex min-h-[260px] items-center justify-center overflow-hidden bg-cream-light px-4 py-8 sm:min-h-[380px] sm:px-8 md:min-h-[520px]">
            <div class="relative w-full max-w-[1120px]">
              <img
                src="/images/floorplans/retail-floorplan.png"
                alt="Pôdorys obchodných priestorov OC SOFI"
                width="1672"
                height="941"
                class="block h-auto w-full object-contain"
                loading="lazy"
              />
              <span class="retail-unit-tint retail-unit-tint--jac" aria-hidden="true"></span>
              <span class="retail-unit-tint retail-unit-tint--tabak" aria-hidden="true"></span>
              <span class="retail-unit-tint retail-unit-tint--bistro" aria-hidden="true"></span>
            </div>
          </div>
        </div>

        <div
          id="floorplan-office"
          role="tabpanel"
          aria-labelledby="floorplan-tab-office"
          data-floorplan-panel="office"
          class="hidden animate-rise"
          hidden
        >
          <p class="mb-5 text-[15px] text-[#6B6863]">Pôdorys kancelárskych priestorov</p>
          <div class="flex min-h-[260px] items-center justify-center overflow-hidden bg-cream-light px-4 py-8 sm:min-h-[380px] sm:px-8 md:min-h-[520px]">
            <img
              src="/images/floorplans/office-floorplan.png"
              alt="Pôdorys kancelárskych priestorov OC SOFI"
              width="1448"
              height="1086"
              class="block h-auto w-full max-w-[760px] object-contain"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-floorplan-switcher]').forEach((switcher) => {
    const tabs = Array.from(switcher.querySelectorAll<HTMLButtonElement>('[data-floorplan-tab]'));
    const panels = Array.from(switcher.querySelectorAll<HTMLElement>('[data-floorplan-panel]'));

    const showFloorplan = (type: string) => {
      tabs.forEach((tab) => {
        const isActive = tab.dataset.floorplanTab === type;
        tab.setAttribute('aria-selected', String(isActive));
        tab.classList.toggle('bg-navy', isActive);
        tab.classList.toggle('text-white', isActive);
        tab.classList.toggle('text-[#5A6470]', !isActive);
      });

      panels.forEach((panel) => {
        const isActive = panel.dataset.floorplanPanel === type;
        panel.hidden = !isActive;
        panel.classList.toggle('hidden', !isActive);
      });
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => showFloorplan(tab.dataset.floorplanTab || 'retail'));
    });
  });
</script>

<style>
  .retail-unit-tint {
    position: absolute;
    z-index: 1;
    pointer-events: none;
    background: #f6f4ee;
    mix-blend-mode: multiply;
    opacity: 0.62;
  }

  .retail-unit-tint--jac {
    top: 63.8%;
    left: 3.7%;
    width: 4.8%;
    height: 26.5%;
  }

  .retail-unit-tint--tabak {
    top: 83.4%;
    left: 17.6%;
    width: 4%;
    height: 6.9%;
  }

  .retail-unit-tint--bistro {
    top: 63.8%;
    left: 21.8%;
    width: 5.4%;
    height: 26.5%;
  }
</style>
