---
import { Image } from 'astro:assets';
import CtaButton from './CtaButton.astro';
import heroImg from '../assets/images/hero.jpg';
---

<section class="relative flex min-h-screen flex-col bg-ink">
  <Image
    src={heroImg}
    widths={[768, 1280, 1920]}
    sizes="100vw"
    alt="Vizualizácia OC SOFI, Bratislavská 74, Trnava"
    class="absolute inset-0 block h-full w-full object-cover"
    loading="eager"
    fetchpriority="high"
  />
  <div
    class="absolute inset-0 bg-[linear-gradient(180deg,rgba(20,19,17,0.52)_0%,rgba(20,19,17,0.34)_34%,rgba(20,19,17,0.76)_100%)]"
  >
  </div>

  <header
    class="relative z-10 flex items-center justify-center px-[clamp(20px,4vw,56px)] py-[30px]"
  >
    <a href="#dopyt" class="flex items-center gap-3" aria-label="OC SOFI">
      <svg
        width="105"
        height="24"
        viewBox="0 0 105 24"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
        class="block h-5 w-auto text-white"
      >
        <path
          d="M95.9752 23.1819H104.153V19.0582H102.109V4.23515H104.153V0H95.9752V4.23515H97.7925V19.0582H95.9752V23.1819ZM64.6271 23.1819H69.0567V13.4856H77.2345L78.3703 9.139H69.0567V4.23515H79.8469L81.2098 0H64.6271V23.1819ZM38.2765 19.2811C37.2543 19.2811 36.4592 18.5009 36.4592 17.4978V6.35272C36.4592 5.23821 37.2543 4.45805 38.2765 4.45805H43.0469C44.0691 4.45805 44.8642 5.34966 44.8642 6.24127V17.4978C44.8642 18.5009 44.0691 19.2811 43.0469 19.2811H38.2765ZM38.5037 23.5162H42.9333C46.3407 23.5162 49.1802 20.7299 49.1802 17.2749V6.46417C49.1802 3.12063 46.3407 0.334354 42.9333 0.334354H38.5037C35.0963 0.334354 32.2568 3.00918 32.2568 6.46417V17.2749C32.2568 20.7299 34.9827 23.5162 38.5037 23.5162ZM6.36049 23.1819H10.7901C14.3111 23.1819 17.037 20.3956 17.037 16.9406V16.049C17.037 13.2627 15.1062 11.0337 12.4938 10.4764L6.24691 8.9161C5.11111 8.58175 4.42962 7.91304 4.42962 6.79853V6.01837C4.42962 5.01531 5.22469 4.23515 6.24691 4.23515H11.1309C13.8568 4.23515 11.4716 6.90998 15.2197 5.90692L17.1506 5.34966C16.9309 3.8829 16.177 2.54396 15.0284 1.58084C13.8798 0.617725 12.4144 0.0956968 10.9037 0.111451H6.24691C2.72592 0.111451 0.113578 2.56338 0.113578 6.01837V7.13288C0.113578 9.69626 1.81728 12.0367 4.08888 12.7054L11.5852 14.6001C12.2667 14.823 12.721 15.4917 12.721 16.1604V17.2749C12.721 18.3895 11.9259 19.1696 11.0173 19.1696H6.01975C2.72592 19.1696 5.33827 16.3833 1.1358 17.4978L0 17.9437C0.217269 19.421 0.966938 20.7731 2.11304 21.7546C3.25914 22.736 4.72577 23.282 6.24691 23.2933"
          fill="currentColor"></path>
      </svg>
    </a>
  </header>

  <div
    class="relative z-5 flex flex-1 flex-col items-center justify-center px-[clamp(20px,4vw,56px)] pt-14 pb-24 text-center"
  >
    <span class="text-[13px] tracking-[0.18em] text-white uppercase"
      >Priestor pre váš biznis na správnom mieste</span
    >
    <h1
      class="mt-6 max-w-[26ch] [text-wrap:balance] text-[clamp(38px,5.6vw,88px)] leading-none font-normal tracking-[-0.03em] text-[#FBF9F6]"
    >
      Obchodné a kancelárske priestory <span
        class="font-serif italic tracking-[-0.01em]">v Trnave</span
      >
    </h1>
    <p
      class="mt-[30px] max-w-[60ch] [text-wrap:pretty] text-[19px] leading-[1.75] text-[#DDD8D0]"
    >
      Objavte moderné priestory s výbornou dostupnosťou, vysokou viditeľnosťou
      a bezproblémovým vlastným parkovaním.
    </p>
    <CtaButton href="#dopyt" class="mt-[38px]">Zistiť dostupné priestory</CtaButton>
    <span
      class="mt-[72px] inline-flex max-w-full items-center gap-3 border border-white/15 bg-black/65 px-4 py-3 text-left shadow-[0_10px_28px_rgba(0,0,0,0.18)] backdrop-blur-sm"
    >
      <span class="flex size-12 flex-none items-center justify-center rounded-full bg-accent text-white">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.25"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"></path>
          <circle cx="12" cy="10" r="2.5"></circle>
        </svg>
      </span>
      <span class="min-w-0">
        <span class="block text-[10px] font-semibold tracking-[0.17em] text-[#C4B7AC] uppercase"
          >Nájdete nás na adrese</span
        >
        <span class="mt-1 block truncate text-[clamp(18px,1.8vw,22px)] leading-none font-medium tracking-[-0.02em] text-white"
          >Bratislavská 74, Trnava</span
        >
      </span>
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        class="ml-2 flex-none text-[#E5DDD6]"
      >
        <path d="M7 17 17 7"></path>
        <path d="M8 7h9v9"></path>
      </svg>
    </span>
  </div>
</section>
