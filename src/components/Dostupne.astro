---
import { Image } from 'astro:assets';
import planOffice from '../assets/images/plan-office.png';

const tabActive =
  'cursor-pointer rounded-full border border-accent bg-accent px-6 py-[14px] text-[15px] font-medium text-white';
const tabInactive =
  'cursor-pointer rounded-full border border-[#D8D0C4] bg-transparent px-6 py-[14px] text-[15px] font-medium text-ink';

const retailUnits = [
  { code: '1.01.01', points: '663,262 733,262 707,406 661,393' },
  { code: '1.01.02', points: '733,262 811,293 778,434 707,406' },
  { code: '1.01.03', points: '811,293 896,341 850,461 778,434' },
  { code: '1.01.04', points: '850,209 938,247 896,341 811,293' },
  { code: '1.01.05', points: '810,155 850,209 811,293 733,262' },
  { code: '1.A6', points: '1236,268 1366,266 1487,304 1430,400 1365,512 1235,467' },
  { code: '1.A5', points: '1300,367 1430,400 1487,304 1366,266' },
  { code: '1.A4', points: '1235,467 1365,512 1430,400 1300,367' },
  { code: '1.A3', points: '1169,585 1297,625 1365,512 1235,467' },
  { code: '1.A2', points: '1102,658 1231,735 1297,625 1169,585' },
  { code: '1.A1', points: '1048,765 1173,840 1231,735 1102,658' },
];
---

<section id="dostupne" class="bg-white">
  <div class="mx-auto max-w-[1440px] px-[clamp(20px,3vw,40px)] py-24">
    <div class="flex flex-wrap items-end justify-between gap-12">
      <div>
        <h2
          class="m-0 max-w-[24ch] [text-wrap:balance] text-[clamp(32px,4.2vw,58px)] leading-[1.06] font-normal tracking-[-0.03em] text-heading"
        >
          Otvorenie druhej etapy je plánované na <span
            class="font-serif italic text-accent">leto 2028</span
          >
        </h2>
      </div>
      <div class="flex flex-wrap gap-[10px]">
        <button
          type="button"
          data-plan-tab="retail"
          data-active-class={tabActive}
          data-inactive-class={tabInactive}
          class={tabActive}>Obchodné priestory</button
        >
        <button
          type="button"
          data-plan-tab="office"
          data-active-class={tabActive}
          data-inactive-class={tabInactive}
          class={tabInactive}>Kancelárske priestory</button
        >
      </div>
    </div>

    <div class="mt-8">
      <div data-plan="retail" class="relative block w-full">
      <img
        src="/images/plan-retail.png"
        alt="Situácia obchodných priestorov, 1. podlažie"
        class="block h-auto w-full"
        loading="lazy"
        />
        <div class="pointer-events-none absolute top-4 right-4 z-10 rounded-full bg-navy/90 px-4 py-2 text-[13px] font-medium text-white shadow-sm" data-retail-unit-label>
          Voľné jednotky
        </div>
        <svg class="absolute inset-0 h-full w-full" viewBox="0 0 1920 1306" preserveAspectRatio="none" aria-label="Interaktívne voľné obchodné jednotky">
          {
            retailUnits.map((unit) => (
              <polygon
                points={unit.points}
                class="cursor-pointer fill-transparent stroke-transparent stroke-[3] transition-[fill,stroke] duration-200 hover:fill-accent/25 hover:stroke-accent focus:fill-accent/30 focus:stroke-accent focus:outline-none"
                data-retail-unit={unit.code}
                role="button"
                tabindex="0"
                aria-label={`Voľná jednotka ${unit.code}`}
              />
            ))
          }
        </svg>
      </div>
      <Image
        data-plan="office"
        src={planOffice}
        alt="Situácia kancelárskych priestorov, 2. podlažie Budovy B"
        class="hidden h-auto w-full"
        loading="lazy"
      />
    </div>
  </div>
</section>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-plan-tab]');
  const plans = document.querySelectorAll<HTMLElement>('[data-plan]');
  const retailUnitLabel = document.querySelector<HTMLElement>('[data-retail-unit-label]');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const selected = tab.dataset.planTab;
      tabs.forEach((t) => {
        t.className =
          t.dataset.planTab === selected
            ? t.dataset.activeClass!
            : t.dataset.inactiveClass!;
      });
      plans.forEach((img) => {
        img.classList.toggle('hidden', img.dataset.plan !== selected);
        img.classList.toggle('block', img.dataset.plan === selected);
      });
    });
  });

  document.querySelectorAll<SVGElement>('[data-retail-unit]').forEach((unit) => {
    const label = `Voľná jednotka ${unit.dataset.retailUnit}`;
    unit.addEventListener('mouseenter', () => {
      if (retailUnitLabel) retailUnitLabel.textContent = label;
    });
    unit.addEventListener('focus', () => {
      if (retailUnitLabel) retailUnitLabel.textContent = label;
    });
    unit.addEventListener('mouseleave', () => {
      if (retailUnitLabel) retailUnitLabel.textContent = 'Voľné jednotky';
    });
    unit.addEventListener('blur', () => {
      if (retailUnitLabel) retailUnitLabel.textContent = 'Voľné jednotky';
    });
  });
</script>
