  {
    icon: '<path d="M12 3 19 6v5c0 4.5-3 7.7-7 10-4-2.3-7-5.5-7-10V6l7-3Z"></path><path d="m8.5 11.8 2.2 2.2 4.8-5"></path>',
    title: 'Overený koncept',
    text: 'OC SOFI je od roku 2019 stabilnou súčasťou lokality so zavedenými prevádzkami a silnými značkami. SOFI 2 nadväzuje na fungujúci koncept a rozširuje ho o nové obchodné, kancelárske a rezidenčné priestory.',
  },
  {
    icon: '<path d="M1.5 12S5 5.5 12 5.5 22.5 12 22.5 12 19 18.5 12 18.5 1.5 12 1.5 12Z"></path><circle cx="12" cy="12" r="3"></circle>',
    title: 'Viditeľnosť',
    text: 'Výborná poloha priamo na Bratislavskej ulici, s veľkoformátovými výkladmi a možnosťou označenia prevádzky nad vstupom aj na pylóne.',
  },
  {
    icon: '<path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path><circle cx="12" cy="10" r="2.5"></circle>',
    title: 'Dostupnosť',
    text: 'Rýchle napojenie na D1 a R1 zabezpečuje pohodlnú dostupnosť z Trnavy aj širšieho regiónu. Zastávka MHD je len minútu chôdze a v centre mesta ste autom do 6 minút.',
  },
  {
    icon: '<rect x="3" y="3" width="18" height="18" rx="4"></rect><path d="M9.5 17V7.5h3.2a3 3 0 0 1 0 6H9.5"></path>',
    title: 'Parkovanie',
    text: 'Bezproblémové parkovanie priamo v areáli. Ponúkame 225 vnútorných a vonkajších miest vrátane nabíjacích staníc pre elektromobily.',
  },
  {
    icon: '<path d="M4 4h7v7H4z"></path><path d="M13 4h7v16h-7z"></path><path d="M4 13h7v7H4z"></path>',
    title: 'Flexibilita',
    text: 'Priestory ponúkajú flexibilné možnosti prispôsobenia podľa potrieb konkrétneho nájomcu. Výmeru aj dispozičné riešenie je možné nastaviť tak, aby priestor čo najlepšie zodpovedal charakteru prevádzky a spôsobu jej fungovania, pričom úpravy je možné riešiť ešte pred dokončením výstavby.',
  },
  {
    icon: '<circle cx="9" cy="8" r="3"></circle><circle cx="17" cy="9" r="2.5"></circle><path d="M3.5 20c.6-3.4 2.5-5 5.5-5s4.9 1.6 5.5 5"></path><path d="M14.5 20c.3-2.2 1.6-3.5 3.8-3.5 1 0 1.8.3 2.5.8"></path>',
    title: 'Silná spádová oblasť',
    text: 'Na rozhraní rezidenčnej a priemyselnej zóny – s prirodzeným pohybom obyvateľov aj tisícok ľudí pracujúcich v okolí. Lokalita sa ďalej rozvíja a priamo oproti OC SOFI pribudne približne 500 nových bytov.',
  },
];
---

<section id="standardy" class="bg-navy">
  <div class="mx-auto max-w-[1280px] px-[clamp(20px,4vw,40px)] py-24">
    <div class="flex flex-wrap items-end justify-between gap-8">
      <h2
        class="sofi-heading m-0 max-w-[18ch] text-[clamp(32px,4.2vw,58px)] leading-[1.06] text-[#FBF9F6]"
      >
        Prečo si vybrať <span class="sofi-emphasis text-accent">OC SOFI</span>
      </h2>
      <div class="flex items-center gap-3" aria-label="Ovládanie carouselu benefitov">
        <button
          type="button"
          data-benefit-prev
          class="flex size-11 items-center justify-center rounded-full border border-white/20 text-[22px] text-white transition-colors hover:border-accent hover:text-accent disabled:cursor-not-allowed disabled:opacity-35"
          aria-label="Predchádzajúce benefity"
        >←</button>
        <button
          type="button"
          data-benefit-next
          class="flex size-11 items-center justify-center rounded-full border border-white/20 text-[22px] text-white transition-colors hover:border-accent hover:text-accent disabled:cursor-not-allowed disabled:opacity-35"
          aria-label="Ďalšie benefity"
        >→</button>
      </div>
    </div>

    <div
      data-benefit-track
      class="benefit-track mt-14 flex snap-x snap-mandatory items-stretch gap-6 overflow-x-auto pb-2 text-center"
      aria-label="Benefity OC SOFI"
    >
      {
        benefits.map((s) => (
          <article class="flex min-h-[360px] w-[min(84vw,340px)] shrink-0 snap-start flex-col rounded-[18px] border border-white/10 bg-navy-card p-9 md:w-[calc((100%-48px)/3)]">
            <span class="mx-auto flex size-[52px] items-center justify-center rounded-full bg-accent/16 text-accent">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={s.icon}
              />
            </span>
            <h3 class="mt-[26px] mb-0 text-[21px] font-medium tracking-[-0.01em] text-[#FBF9F6]">
              {s.title}
            </h3>
            <p class="mt-[10px] mb-0 text-[15px] leading-[1.75] text-[#8FA0B3]">
              {s.text}
            </p>
          </article>
        ))
      }
    </div>
    <div class="mt-8 h-px w-full overflow-hidden bg-white/15" aria-hidden="true">
      <span data-benefit-progress class="block h-full w-[33.333%] bg-accent transition-[width,transform] duration-300"></span>
    </div>
  </div>
</section>

<script>
  const benefitTrack = document.querySelector<HTMLElement>('[data-benefit-track]');
  const benefitPrev = document.querySelector<HTMLButtonElement>('[data-benefit-prev]');
  const benefitNext = document.querySelector<HTMLButtonElement>('[data-benefit-next]');
  const benefitProgress = document.querySelector<HTMLElement>('[data-benefit-progress]');
  let dragStartX = 0;
  let dragStartScroll = 0;
  let isDragging = false;

  const updateBenefitControls = () => {
    if (!benefitTrack) return;
    const maxScroll = benefitTrack.scrollWidth - benefitTrack.clientWidth;
    const ratio = maxScroll > 0 ? benefitTrack.scrollLeft / maxScroll : 0;
    const visibleRatio = benefitTrack.clientWidth / benefitTrack.scrollWidth;

    if (benefitProgress) {
      benefitProgress.style.width = `${Math.max(visibleRatio * 100, 16.667)}%`;
      benefitProgress.style.transform = `translateX(${ratio * ((1 / visibleRatio) - 1) * 100}%)`;
    }
    if (benefitPrev) benefitPrev.disabled = benefitTrack.scrollLeft <= 2;
    if (benefitNext) benefitNext.disabled = benefitTrack.scrollLeft >= maxScroll - 2;
  };

  const moveBenefits = (direction: number) => {
    if (!benefitTrack) return;
    const firstCard = benefitTrack.querySelector<HTMLElement>('article');
    const gap = Number.parseFloat(getComputedStyle(benefitTrack).gap) || 0;
    const step = (firstCard?.getBoundingClientRect().width || benefitTrack.clientWidth) + gap;
    benefitTrack.scrollBy({ left: direction * step, behavior: 'smooth' });
  };

  benefitPrev?.addEventListener('click', () => moveBenefits(-1));
  benefitNext?.addEventListener('click', () => moveBenefits(1));
  benefitTrack?.addEventListener('scroll', updateBenefitControls, { passive: true });
  window.addEventListener('resize', updateBenefitControls);

  benefitTrack?.addEventListener('pointerdown', (event) => {
    isDragging = true;
    dragStartX = event.clientX;
    dragStartScroll = benefitTrack.scrollLeft;
    benefitTrack.setPointerCapture(event.pointerId);
  });

  benefitTrack?.addEventListener('pointermove', (event) => {
    if (!isDragging) return;
    benefitTrack.scrollLeft = dragStartScroll - (event.clientX - dragStartX);
  });

  const stopBenefitDrag = () => {
    isDragging = false;
  };

  benefitTrack?.addEventListener('pointerup', stopBenefitDrag);
  benefitTrack?.addEventListener('pointercancel', stopBenefitDrag);
  updateBenefitControls();
</script>

<style>
  .benefit-track {
    scrollbar-width: none;
    cursor: grab;
  }

  .benefit-track::-webkit-scrollbar {
    display: none;
  }

  .benefit-track:active {
    cursor: grabbing;
  }
</style>
