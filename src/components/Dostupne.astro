<section id="dostupne" class="bg-white">
  <div class="mx-auto max-w-[1280px] px-[clamp(20px,4vw,40px)] py-24">
    <div>
      <h2
        class="m-0 max-w-[24ch] [text-wrap:balance] text-[clamp(32px,4.2vw,58px)] leading-[1.06] font-normal tracking-[-0.03em] text-heading"
      >
        Otvorenie druhej etapy je plánované na <span
          class="font-serif italic text-accent">leto 2028</span
        >
      </h2>
    </div>

    <div data-floorplan-switcher>
      <div
        class="mt-10 inline-flex w-full flex-col gap-2 rounded-[18px] bg-cream-light p-2 sm:w-auto sm:flex-row"
        role="tablist"
        aria-label="Typ pôdorysu"
      >
        <button
          id="floorplan-tab-retail"
          type="button"
          role="tab"
          aria-selected="true"
          aria-controls="floorplan-retail"
          data-floorplan-tab="retail"
          class="rounded-xl bg-navy px-5 py-3 text-[15px] font-medium text-white transition-colors"
        >
          Obchodné priestory
        </button>
        <button
          id="floorplan-tab-office"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="floorplan-office"
          data-floorplan-tab="office"
          class="rounded-xl px-5 py-3 text-[15px] font-medium text-[#5A6470] transition-colors hover:text-navy"
        >
          Kancelárske priestory
        </button>
      </div>

      <div
        id="floorplan-retail"
        role="tabpanel"
        aria-labelledby="floorplan-tab-retail"
        data-floorplan-panel="retail"
        class="mt-10"
      >
      <div class="md:mx-auto md:w-[min(88vw,1500px)] md:max-w-[1500px]">
        <button
          type="button"
          class="group relative block w-full cursor-zoom-in text-left"
          data-floorplan-open="retail"
          aria-label="Otvoriť pôdorys obchodných priestorov na celú obrazovku"
        >
          <picture class="block w-full">
            <source
              media="(max-width: 767px)"
              srcset="/images/podorysy/OC%20SOFI-podorys-mobil-SK.svg"
              width="1080"
              height="1080"
            />
            <img
              src="/images/podorysy/OC%20SOFI-podorys-SK.svg"
              alt="Pôdorys obchodných priestorov OC SOFI"
              width="1604"
              height="1080"
              class="block h-auto w-full"
              loading="lazy"
            />
          </picture>
          <span class="absolute right-3 bottom-3 flex size-9 items-center justify-center rounded-full bg-black/60 text-[18px] text-white opacity-0 backdrop-blur-sm transition-opacity group-hover:opacity-100" aria-hidden="true">↗</span>
        </button>
      </div>
      </div>

      <div
        id="floorplan-office"
        role="tabpanel"
        aria-labelledby="floorplan-tab-office"
        data-floorplan-panel="office"
        class="mt-10 hidden"
        hidden
      >
        <div class="md:mx-auto md:w-[min(88vw,1500px)] md:max-w-[1500px]">
          <button
            type="button"
            class="group relative block w-full cursor-zoom-in text-left"
            data-floorplan-open="office"
            aria-label="Otvoriť pôdorys kancelárskych priestorov na celú obrazovku"
          >
            <picture class="block w-full">
              <source
                media="(max-width: 767px)"
                srcset="/images/podorysy/OC%20SOFI-kancelarie-mobil-SK.svg"
                width="1080"
                height="1080"
              />
              <img
                src="/images/podorysy/OC%20SOFI-kancelarie-SK.svg"
                alt="Pôdorys kancelárskych priestorov OC SOFI"
                width="1604"
                height="1080"
                class="block h-auto w-full"
                loading="lazy"
              />
            </picture>
            <span class="absolute right-3 bottom-3 flex size-9 items-center justify-center rounded-full bg-black/60 text-[18px] text-white opacity-0 backdrop-blur-sm transition-opacity group-hover:opacity-100" aria-hidden="true">↗</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<dialog
  data-floorplan-lightbox
  class="fixed inset-0 m-auto h-dvh w-dvw max-h-none max-w-none border-0 bg-black/92 p-5 text-white backdrop:bg-black/70"
  aria-label="Pôdorys na celú obrazovku"
>
  <div class="relative mx-auto flex h-full max-w-[1600px] items-center justify-center">
    <button
      type="button"
      data-floorplan-lightbox-close
      class="absolute top-0 right-0 z-10 flex size-11 items-center justify-center rounded-full bg-white/12 text-[26px] transition-colors hover:bg-white/22"
      aria-label="Zavrieť pôdorys">×</button
    >
    <img
      data-floorplan-lightbox-image
      src=""
      alt=""
      class="max-h-[calc(100dvh-80px)] max-w-full bg-white object-contain"
    />
  </div>
</dialog>

<script>
  document.querySelectorAll<HTMLElement>('[data-floorplan-switcher]').forEach((switcher) => {
    const tabs = Array.from(switcher.querySelectorAll<HTMLButtonElement>('[data-floorplan-tab]'));
    const panels = Array.from(switcher.querySelectorAll<HTMLElement>('[data-floorplan-panel]'));

    const showFloorplan = (type: string) => {
      tabs.forEach((tab) => {
        const isActive = tab.dataset.floorplanTab === type;
        tab.setAttribute('aria-selected', String(isActive));
        tab.classList.toggle('bg-navy', isActive);
        tab.classList.toggle('text-white', isActive);
        tab.classList.toggle('text-[#5A6470]', !isActive);
      });

      panels.forEach((panel) => {
        const isActive = panel.dataset.floorplanPanel === type;
        panel.hidden = !isActive;
        panel.classList.toggle('hidden', !isActive);
      });
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => showFloorplan(tab.dataset.floorplanTab || 'retail'));
    });
  });

  const floorplans: Record<string, { desktop: string; mobile: string; alt: string }> = {
    retail: {
      desktop: '/images/podorysy/OC%20SOFI-podorys-SK.svg',
      mobile: '/images/podorysy/OC%20SOFI-podorys-mobil-SK.svg',
      alt: 'Pôdorys obchodných priestorov OC SOFI',
    },
    office: {
      desktop: '/images/podorysy/OC%20SOFI-kancelarie-SK.svg',
      mobile: '/images/podorysy/OC%20SOFI-kancelarie-mobil-SK.svg',
      alt: 'Pôdorys kancelárskych priestorov OC SOFI',
    },
  };

  const floorplanLightbox = document.querySelector<HTMLDialogElement>('[data-floorplan-lightbox]');
  const floorplanLightboxImage = floorplanLightbox?.querySelector<HTMLImageElement>('[data-floorplan-lightbox-image]');

  document.querySelectorAll<HTMLButtonElement>('[data-floorplan-open]').forEach((button) => {
    button.addEventListener('click', () => {
      const plan = floorplans[button.dataset.floorplanOpen || 'retail'];
      if (!plan || !floorplanLightbox || !floorplanLightboxImage) return;
      const isMobile = window.matchMedia('(max-width: 767px)').matches;
      floorplanLightboxImage.src = isMobile ? plan.mobile : plan.desktop;
      floorplanLightboxImage.alt = plan.alt;
      floorplanLightbox.showModal();
    });
  });

  floorplanLightbox
    ?.querySelector('[data-floorplan-lightbox-close]')
    ?.addEventListener('click', () => floorplanLightbox.close());
</script>

